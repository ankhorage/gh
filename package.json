{
  "name": "@ankhorage/repository",
  "version": "0.3.1",
  "description": "Standalone typed GitHub integration for connecting any project, powered by the local gh CLI.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/repository#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/repository/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/repository.git"
  },
  "keywords": [
    "ankhorage",
    "github",
    "git",
    "cli",
    "automation",
    "repository",
    "typescript",
    "bun"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "ankh": {
    "category": "repository",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      "repository.connect"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.10.10",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@ankhorage/contracts": "^10.0.0",
    "ignore": "^7.0.8"
  }
}
